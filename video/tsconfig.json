{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": true,
        "paths": {
            "@/*": ["../resources/js/*"],
            "react": ["./node_modules/@types/react"],
            "react/*": ["./node_modules/@types/react/*"]
        }
    },
    "include": ["src", "scripts", "remotion.config.ts"]
}
